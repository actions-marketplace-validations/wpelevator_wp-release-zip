{
	"private": true,
	"name": "@wpelevator/wp-release-zip-action",
	"version": "0.3.4",
	"description": "GitHub Action: create a ZIP of a WordPress plugin or theme with a {slug}/ root folder, respecting .distignore.",
	"license": "MIT",
	"type": "module",
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@wpelevator/wp-release": "0.13.0"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@wordpress/scripts": "^33.0",
		"esbuild": "^0.27.7",
		"npm-run-all2": "^9.0",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"build": "node build.js",
		"lint": "npm-run-all lint:*",
		"lint:js": "wp-scripts lint-js",
		"lint:types": "tsc -p tsconfig.json",
		"format": "wp-scripts format build.js src",
		"test": "node --test"
	}
}
